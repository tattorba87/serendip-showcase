# Public-safe architecture sketch: the SHAPE of the system, never addresses —
# no hostnames, no IPs, no route names. Laid out as a left-to-right pipeline so
# it reads as one story: city sources in, phone out. Ten seconds or nothing.

direction: right

sources: "City sources\nfeeds + venue pages" { shape: cloud }
ingest: "Nightly ingestion\nPython" { shape: package }
db: "Postgres" { shape: cylinder }
api: "API\nHono + TypeScript" { shape: rectangle }
phone: "Mobile app\nReact Native" { shape: rectangle }
llm: "Self-hosted models\nextraction · embeddings · chat" { shape: cloud }

sources -> ingest: fetch
ingest -> db: "structured rows"
db -> api: SQL
api -> phone: HTTPS

ingest -> llm
api -> llm
